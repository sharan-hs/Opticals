{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "includeFiles": "{app/**,alembic/**,alembic.ini}",
      "excludeFiles": "{tests/**,**/__pycache__/**,.venv/**}"
    }
  },
  "crons": [{ "path": "/api/v1/internal/expire-orders", "schedule": "*/10 * * * *" }]
}
