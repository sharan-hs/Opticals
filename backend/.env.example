# Copy to .env and fill in. Never commit .env.
# APP_ENV: development | test | staging | production
APP_ENV=development

# postgres:// and postgresql:// URLs are accepted and switched to psycopg 3.
DATABASE_URL=postgresql+psycopg://opticals:CHANGE_ME@localhost:5432/opticals_dev
# Used by the test suite (APP_ENV=test). The database name must end in _test:
# the tests wipe it.
TEST_DATABASE_URL=postgresql+psycopg://opticals:CHANGE_ME@localhost:5432/opticals_test

# Comma-separated list of exact origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Signs access tokens (Phase 3). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to start with the default or a short value.
JWT_SECRET=dev-only-insecure-jwt-secret

LOG_LEVEL=INFO
# Error reporting; leave empty to disable.
SENTRY_DSN=

# Lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Defaults to true outside development/test.
# COOKIE_SECURE=true
# true on Vercel: read the client IP from X-Forwarded-For (rate limits).
TRUST_PROXY_HEADERS=false

# Email: console (prints to the log) or resend
EMAIL_PROVIDER=console
EMAIL_FROM=Vijai Opticians <no-reply@localhost>
RESEND_API_KEY=

# Cloudinary (product images). API key/secret are needed for admin uploads.
CLOUDINARY_CLOUD_NAME=dyf8dp9oo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=uploads

# Scheduled jobs (Vercel Cron). Any long random string.
CRON_SECRET=
