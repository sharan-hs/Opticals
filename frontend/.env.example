# Copy to .env.local for local overrides. Vite only exposes variables
# prefixed with VITE_ to the browser — never put secrets here.
VITE_CLOUDINARY_CLOUD_NAME=dyf8dp9oo
# API location. Leave unset: /api/v1 on the same origin, forwarded to the backend by
# Vite in development and by Vercel in production (vercel.json).
# VITE_API_BASE_URL=/api/v1
